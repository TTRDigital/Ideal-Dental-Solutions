# Copy to .env.local for local development. In Vercel, add these under
# Project Settings > Environment Variables. Never commit real values.

# --- Site
NEXT_PUBLIC_SITE_URL=https://idealdentalsolutions.com
# Sanity project ncba5cqx is built in (sanity/env.ts). Optional other dataset:
# NEXT_PUBLIC_IDS_SANITY_DATASET=production
# "local" shows the built-in copy (content/seed.json) instead of the CMS.
# SITE_CONTENT=local

# --- Sanity
# Shared secret for the /api/revalidate webhook (same value in the Sanity webhook)
SANITY_REVALIDATE_SECRET=
# Only for `npm run seed` on your machine (Editor token). Not needed in Vercel.
SANITY_WRITE_TOKEN=

# --- Form submissions (at least one destination)
# GoHighLevel inbound webhook. The practice's webhook is built in (lib/lead.ts);
# set this only to send form submissions somewhere else.
GHL_WEBHOOK_URL=
# Email notification through Resend (resend.com). LEAD_EMAIL_TO accepts a comma-separated list.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Google reCAPTCHA v2 (checkbox) in the appointment form. Empty site key = no reCAPTCHA box
# (the old key only works on the WordPress domain). Set both after go-live.
RECAPTCHA_SITE_KEY=
# Secret for the same key: submissions are then checked server-side. Empty = not checked.
RECAPTCHA_SECRET_KEY=
