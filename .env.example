# Copy to .env.local for local development. In Vercel, add these under
# Project Settings > Environment Variables. Never commit real values.

# --- Site
NEXT_PUBLIC_SITE_URL=https://idealdentalsolutions.com
# Sanity project ncba5cqx is built in (sanity/env.ts). Optional other dataset:
# NEXT_PUBLIC_IDS_SANITY_DATASET=production
# "local" shows the built-in copy (content/seed.json) instead of the CMS.
# SITE_CONTENT=local

# --- Sanity
# Shared secret for the /api/revalidate webhook (same value in the Sanity webhook)
SANITY_REVALIDATE_SECRET=
# Editor token. In Vercel it lets an owner or build lead run POST /api/admin/seed/
# (server-side seed, see README); on your machine it is used by `npm run seed`.
SANITY_WRITE_TOKEN=

# --- Form submissions (at least one destination)
# GoHighLevel inbound webhook. The practice's webhook is built in (lib/lead.ts);
# set this only to send form submissions somewhere else.
GHL_WEBHOOK_URL=
# Email notification through Resend (resend.com). LEAD_EMAIL_TO accepts a comma-separated list.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Google reCAPTCHA "I'm not a robot" checkbox (v2) on the appointment form (lib/recaptcha.ts). The site key is built in;
# set RECAPTCHA_SITE_KEY only to use another one (or "off" to turn reCAPTCHA off).
RECAPTCHA_SITE_KEY=
# Secret for the same key, from google.com/recaptcha/admin. Required for the server check; never commit it.
RECAPTCHA_SECRET_KEY=

# Signing key for the invisible form protection (TTR-2337): any long random string, never public.
# Until it is set, a key is derived from SANITY_REVALIDATE_SECRET / PREVIEW_SECRET / RECAPTCHA_SECRET_KEY;
# with none of them the token and minimum-time checks are off (the other checks still run).
FORM_TOKEN_SECRET=

# --- Private draft previews (TTR OS staging, /api/preview)
# Same value as the site's preview secret saved in TTR OS (SEO Setup, Sanity card).
PREVIEW_SECRET=
# Sanity Viewer token, so a preview can read unpublished drafts. Never public.
SANITY_PREVIEW_TOKEN=
